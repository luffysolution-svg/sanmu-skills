{
  "name": "sanmu-paper-search",
  "version": "1.10.3",
  "description": "在对话侧栏与 Agent 中使用三木文献检索与文档解析：支持 OpenAlex、Semantic Scholar、Crossref、Europe PMC、SciVerse (全文语义RAG/原文切片与配图/Paper Schema)、AI4Scholar (S2/Google Scholar/Patents/PubMed/科研绘图/自动引文)、Serper、Exa AI、easyScholar 期刊分区/IF 标注、OA PDF / SI 下载、本机 Zotero 双向联动，以及 sanmu-doc2md 学术文档转 Obsidian Markdown 知识库（论文+SI双链、课件与教材解析）。",
  "type": "module",
  "main": "./scripts/dsh-plugin.mjs",
  "exports": {
    ".": "./scripts/dsh-plugin.mjs",
    "./package.json": "./package.json",
    "./client": "./scripts/dsh-client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "author": "Sanmu (Wu Sen)",
  "repository": {
    "type": "git",
    "url": "https://github.com/luffysolution-svg/sanmu-skills"
  },
  "engines": {
    "node": ">=22.20.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    ".zcode-plugin",
    ".claude-plugin",
    "assets",
    "commands",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/dsh-client.js",
    "locale/en.json",
    "locale/zh.json"
  ]
}
