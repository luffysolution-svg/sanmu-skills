        "USER_CONFIG_POLITE_EMAIL", "USER_CONFIG_OPENALEX_API_KEY", "USER_CONFIG_S2_API_KEY", "USER_CONFIG_EXA_API_KEY", "USER_CONFIG_SERPER_API_KEY",
        "USER_CONFIG_EASYSCHOLAR_SECRET_KEY", "USER_CONFIG_AI4SCHOLAR_API_KEY", "USER_CONFIG_SCIVERSE_API_KEY", "USER_CONFIG_MINERU_API_TOKEN",
